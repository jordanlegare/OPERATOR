Unit]
Description=OPERATOR persistent shell session daemon
Documentation=https://github.com/jordanlegare/OPERATOR

[Service]
Type=simple
User=guest
Group=guest
EnvironmentFile=/etc/operator/operator.env
ExecStart=/bin/operator daemon
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
