[Unit]
Description=OPERATOR persistent shell session daemon
Documentation=https://github.com/jordanlegare/OPERATOR
After=default.target

[Service]
Type=simple
ExecStart=/usr/local/bin/operator daemon
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
